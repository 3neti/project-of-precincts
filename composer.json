{
    "name": "3neti/project-of-precincts",
    "description": "Immutable precinct topology and POP package primitives for election-source compilation",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "LBHurtado\\ProjectOfPrecincts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LBHurtado\\ProjectOfPrecincts\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
